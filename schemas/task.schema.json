{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIOSBench proposed task schema",
  "type": "object",
  "required": [
    "id",
    "track",
    "source_repository",
    "base_commit",
    "issue",
    "oracle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "track": {
      "enum": [
        "edk2-ovmf",
        "coreboot"
      ]
    },
    "source_repository": {
      "type": "string",
      "format": "uri"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "required": [
        "build",
        "behavioral",
        "regression"
      ],
      "properties": {
        "build": {
          "type": "string"
        },
        "behavioral": {
          "type": "string"
        },
        "regression": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "validated"
      ]
    }
  },
  "additionalProperties": false
}
